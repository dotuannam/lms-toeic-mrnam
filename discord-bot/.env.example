# ==============================================================================
# DISCORD BOT CREDENTIALS
# Lấy từ: https://discord.com/developers/applications
# ==============================================================================
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_discord_server_id_here

# ==============================================================================
# DISCORD CHANNEL IDS
# Click chuột phải vào từng kênh trên Discord -> Copy Channel ID
# (Cần bật Developer Mode trong Discord Settings -> Advanced -> Developer Mode)
# ==============================================================================
# Kênh ghi nhận toàn bộ lịch sử thao tác của users (đăng nhập, sửa điểm, điểm danh, nộp học phí...)
DISCORD_CHANNEL_AUDIT_LOG=123456789012345678

# Kênh nhận báo cáo tự động (07:30 sáng lịch học, 22:00 tối tổng kết ngày)
DISCORD_CHANNEL_DAILY_REPORTS=123456789012345679

# Kênh cảnh báo tức thì (học viên nghỉ nhiều buổi, trễ hạn học phí, giao dịch VietQR mới)
DISCORD_CHANNEL_ALERTS=123456789012345680

# ==============================================================================
# FIREBASE CONFIGURATION
# Cách 1 (Khuyên dùng): Tải serviceAccountKey.json từ Firebase Console -> Project Settings -> Service accounts
# Đặt file vào thư mục discord-bot/serviceAccountKey.json
# ==============================================================================
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=auto-lms-43b1d

# Cách 2 (Tùy chọn): Nếu triển khai lên hosting không có file json, dùng biến môi trường:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@auto-lms-43b1d.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ==============================================================================
# SCHEDULED CRON TIMINGS (Mặc định giờ Việt Nam GMT+7)
# ==============================================================================
CRON_MORNING_BRIEFING="30 7 * * *"
CRON_EVENING_BRIEFING="0 22 * * *"
CRON_ALERT_CHECK="0 */3 * * *"
TIMEZONE="Asia/Ho_Chi_Minh"
